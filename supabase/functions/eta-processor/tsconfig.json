{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false, // <-- Hata veren katı kuralları kapatır
    "noImplicitAny": false, // <-- En çok hatayı veren 'implicitly has an any type' kapatır
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [ "es2020", "dom" ],
    "types": [ "deno_node" ],
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
